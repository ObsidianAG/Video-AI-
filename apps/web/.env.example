# =============================================================================
# Video AI — Environment Configuration
# =============================================================================
# Copy this file to .env.local (never commit .env.local).
# All variables are read server-side only. Never prefix with NEXT_PUBLIC_.
# =============================================================================

# --- Database (required for any job creation or listing) ---
# PostgreSQL connection string. Must point to a database where 0001_init.sql
# has been applied.
DATABASE_URL=******localhost:5432/video_ai

# --- Queue (BullMQ / Redis) — not wired yet ---
REDIS_URL=

# --- Storage — choose one and wire its adapter ---
# Not wired yet. Set STORAGE_PROVIDER to 's3', 'r2', 'vercel_blob', 'gcs', or 'azure_blob'.
STORAGE_PROVIDER=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Provider API keys — server-side ONLY ---
# Set at least one to enable video generation.

# OpenAI Sora
# Required: OPENAI_API_KEY
# Models: sora-1.0-hd, sora-1.0-sd
OPENAI_API_KEY=

# Google Vertex AI — VEO 3
# Required: all three variables + a service account key file with Vertex AI access
# Location: e.g. us-central1
# Model: veo-003
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Kling AI
# Required: KLING_API_KEY
# Models: kling-v1, kling-v1-5
KLING_API_KEY=

# Replicate — not wired yet (adapter pending)
REPLICATE_API_TOKEN=
REPLICATE_WEBHOOK_SECRET=

# Runway — not wired yet (adapter pending)
RUNWAY_API_KEY=

# fal.ai — not wired yet (adapter pending)
FAL_KEY=

# --- Auth — not wired yet ---
# AUTH_SECRET must be at least 32 random bytes (base64 or hex).
AUTH_SECRET=
