# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg-compatible PostgreSQL DSN
DATABASE_URL=******localhost:5432/video_ai

# ── Auth ──────────────────────────────────────────────────────────────────────
# Run `openssl rand -hex 32` to generate values for JWT_SECRET and SERVICE_TOKEN
JWT_SECRET=replace-with-openssl-rand-hex-32-output
JWT_ALGORITHM=HS256
JWT_AUDIENCE=ava-backend

# ── Internal service token (worker → API) ─────────────────────────────────────
SERVICE_TOKEN=replace-with-openssl-rand-hex-32-output

# ── Optional integrations ─────────────────────────────────────────────────────
# Leave blank to disable OpenAI-dependent features
OPENAI_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
