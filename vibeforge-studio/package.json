{
  "name": "vibeforge-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "gate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && node tools/verify_no_secret_in_bundle.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.20.0",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
