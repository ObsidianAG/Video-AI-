# ============================================================
# VEO3 Creator OS — Environment Variables Example
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://veo3:changeme@localhost:5432/veo3

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth (JWT) ───────────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-char-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── AWS / S3 ─────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
S3_BUCKET=veo3-assets-dev
S3_PRESIGNED_EXPIRE_SECONDS=900

# ── Google Cloud / Vertex AI ─────────────────────────────────
GOOGLE_CLOUD_PROJECT=my-gcp-project
GOOGLE_CLOUD_REGION=us-central1
VERTEX_AI_ENDPOINT=us-central1-aiplatform.googleapis.com
VEO_MODEL=veo-3.0-generate-preview

# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Kling ────────────────────────────────────────────────────
KLING_API_KEY=kling_...
KLING_API_BASE_URL=https://api.klingai.com

# ── vLLM ─────────────────────────────────────────────────────
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=meta-llama/Llama-3-8b-instruct

# ── Gemini (optional verifier) ────────────────────────────────
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-pro

# ── Media service ─────────────────────────────────────────────
MEDIA_SERVICE_URL=http://localhost:3001
MEDIA_SERVICE_SECRET=internal-shared-secret

# ── OpenTelemetry ────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=veo3-api
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── QNEO Digital Twin ────────────────────────────────────────
QNEO_SNAPSHOT_TTL_SECONDS=30
QNEO_REDIS_KEY_PREFIX=qneo:snapshot:
